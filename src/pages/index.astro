---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { stateList } from '../config/states.mjs';
import { DEPOTS as UP_DEPOTS, depotSlug } from '../data/uttar-pradesh/depots.data.mjs';
import { DEPOTS as MH_DEPOTS } from '../data/maharashtra/depots.data.mjs';
import { DEPOTS as RJ_DEPOTS } from '../data/rajasthan/depots.data.mjs';
import { DEPOTS as HR_DEPOTS } from '../data/haryana/depots.data.mjs';
import { DEPOTS as HP_DEPOTS } from '../data/himachal-pradesh/depots.data.mjs';
import { DEPOTS as UK_DEPOTS } from '../data/uttarakhand/depots.data.mjs';
import { DEPOTS as PB_DEPOTS } from '../data/punjab/depots.data.mjs';
import { DEPOTS as GJ_DEPOTS } from '../data/gujarat/depots.data.mjs';
import { ROUTES } from '../data/routes.data.mjs';

const title = 'State Road Transport Helplines & Intercity Bus Timetables — All RTCs';
const description = 'Official directory of Indian State Road Transport Corporation (RTC) bus stand enquiry numbers, station master helplines, and intercity express bus timetables across 8 states.';

const allDepotSources = [
  { stateId: 'uttar-pradesh', corp: 'UPSRTC', depots: UP_DEPOTS },
  { stateId: 'maharashtra', corp: 'MSRTC', depots: MH_DEPOTS },
  { stateId: 'rajasthan', corp: 'RSRTC', depots: RJ_DEPOTS },
  { stateId: 'haryana', corp: 'Haryana Roadways', depots: HR_DEPOTS },
  { stateId: 'himachal-pradesh', corp: 'HRTC', depots: HP_DEPOTS },
  { stateId: 'uttarakhand', corp: 'UTC', depots: UK_DEPOTS },
  { stateId: 'punjab', corp: 'PUNBUS', depots: PB_DEPOTS },
  { stateId: 'gujarat', corp: 'GSRTC', depots: GJ_DEPOTS },
];

const allSearchEntries = [
  ...allDepotSources.flatMap(({ stateId, corp, depots }) =>
    depots.map((d) => {
      const name = d.alsoKnownAs ? d.region : d.city[0].toUpperCase() + d.city.slice(1);
      return {
        title: `${name} Bus Station Contact Number`,
        sub: `${corp} · ${d.stands.length} counter${d.stands.length > 1 ? 's' : ''} (Primary: ${d.stands[0].numbers[0]})`,
        url: `/${stateId}/${depotSlug(d.city)}`,
        action: 'View numbers',
        keywords: `${d.city} ${d.region} ${d.alsoKnownAs || ''} ${corp} ${stateId} bus stand station enquiry phone contact`.toLowerCase(),
      };
    })
  ),
  ...ROUTES.map((r) => ({
    title: `${r.originCity} to ${r.destinationCity} Bus Timetable`,
    sub: `${r.corporation} Express · ${r.frequency} · Fares from ${r.fares[0].price}`,
    url: `/${r.stateId}/routes/${r.slug}`,
    action: 'View timetable',
    keywords: `${r.originCity} ${r.destinationCity} bus time table timings ticket price fare schedule express`.toLowerCase(),
  })),
  {
    title: 'National Emergency Helpline (112)',
    sub: 'All-India Police, Medical & Disaster Emergency',
    url: 'tel:112',
    action: 'Call 112',
    keywords: 'emergency national helpline 112 police accident ambulance',
  },
  {
    title: 'National Highway Helpline (1033)',
    sub: 'NHAI 24x7 Breakdown, Towing & Ambulance Support',
    url: 'tel:1033',
    action: 'Call 1033',
    keywords: 'highway helpline 1033 nhai towing breakdown expressway',
  },
];

const stateCodes: Record<string, string> = {
  'uttar-pradesh': 'UP',
  'maharashtra': 'MH',
  'rajasthan': 'RJ',
  'haryana': 'HR',
  'himachal-pradesh': 'HP',
  'uttarakhand': 'UK',
  'punjab': 'PB',
  'gujarat': 'GJ',
};

const topCorridors = ROUTES.slice(0, 8);
---

<Base title={title} description={description} path="/">

  <!-- Terminal Departure Board Header -->
  <section class="hero-station-header">
    <h1 class="page-title">National State Road Transport Directory</h1>
    <p class="page-lede">
      Verified inquiry telephone numbers, station master control desks, and intercity bus timetables across Indian State Road Transport Corporations. Sourced directly from official gazetted transport records.
    </p>
  </section>

  <!-- Above-The-Fold Ad Slot -->
  <AdSlot slotId="8460038937" label="Advertisement" />

  <!-- Terminal Search & Lookup Board -->
  <section class="terminal-board" aria-label="Bus station enquiry lookup">
    <div class="terminal-board-header">
      <div class="terminal-board-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span>Depot Enquiry &amp; Timetable Terminal</span>
      </div>
      <div style="font-size:0.75rem;color:var(--ink-muted);font-variant-numeric:tabular-nums;">
        128 Divisional Stations · 70 Intercity Corridors
      </div>
    </div>

    <div class="terminal-search-box">
      <div class="search-input-group">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="national-search-input" class="search-input" placeholder="Type any station or route (e.g. Lucknow, Swargate, Jaipur, Shimla, Dehradun)..." aria-label="Search all RTC bus stations" autocomplete="off" />
      </div>
      <div id="search-dropdown-menu" class="search-dropdown" style="display:none;" role="listbox"></div>
    </div>

    <!-- State Matrix Grid -->
    <div class="state-selector-matrix">
      <div class="state-matrix-label">Select State Road Transport Corporation:</div>
      <div class="state-grid-board">
        {stateList.map((s) => {
          const code = stateCodes[s.id] || 'IN';
          const match = allDepotSources.find((src) => src.stateId === s.id);
          const count = match ? match.depots.length : 0;
          return (
            <a class="state-board-card" href={`/${s.slug}`}>
              <span class="state-code-badge">{code}</span>
              <div class="state-board-info">
                <span class="state-board-name">{s.name}</span>
                <span class="state-board-corp">{s.corporation}</span>
                <span class="state-board-count">{count} Divisional Stations · 24x7 Helpline</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Popular Intercity Schedules Matrix -->
  <section style="margin:2.5rem 0;" aria-labelledby="top-corridors-heading">
    <h2 class="section-h2" id="top-corridors-heading">High-Frequency Intercity Timetables</h2>
    <div class="table-container">
      <table class="depot-table">
        <thead>
          <tr>
            <th>Route Corridor</th>
            <th>Operator</th>
            <th>Frequency</th>
            <th>First Bus</th>
            <th>Last Bus</th>
            <th>Starting Fare</th>
            <th>Timetable</th>
          </tr>
        </thead>
        <tbody>
          {topCorridors.map((r) => (
            <tr>
              <td class="depot-name-cell">
                <a href={`/${r.stateId}/routes/${r.slug}`} style="color:var(--ink);text-decoration:none;font-weight:700;">
                  {r.originCity} ⇄ {r.destinationCity}
                </a>
              </td>
              <td style="font-size:0.85rem;color:var(--transit-amber);font-weight:600;">{r.corporation}</td>
              <td style="font-size:0.85rem;">{r.frequency}</td>
              <td class="depot-number-cell">{r.firstBus}</td>
              <td class="depot-number-cell">{r.lastBus}</td>
              <td class="depot-number-cell" style="color:var(--transit-green);font-weight:700;">{r.fares[0].price}</td>
              <td>
                <a href={`/${r.stateId}/routes/${r.slug}`} class="nav-state-pill" style="font-size:0.75rem;padding:0.25rem 0.5rem;">
                  Schedule
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Mid-Content Ad Slot -->
  <AdSlot slotId="8460038937" label="Sponsored Advertisement" />

  <!-- Emergency & Highway Fast-Dial Strip -->
  <section style="margin:2rem 0;" aria-labelledby="emergency-strip-heading">
    <h2 class="section-h2" id="emergency-strip-heading">National Passenger &amp; Highway Emergency Desks</h2>
    <div class="emergency-matrix-strip">
      <div class="emergency-matrix-cell">
        <div class="emergency-matrix-text">
          <span class="emergency-matrix-label">National Emergency</span>
          <span class="emergency-matrix-desc">Police, Medical &amp; Fire</span>
        </div>
        <a class="btn-dial" href="tel:112">112</a>
      </div>
      <div class="emergency-matrix-cell">
        <div class="emergency-matrix-text">
          <span class="emergency-matrix-label">National Highway</span>
          <span class="emergency-matrix-desc">Breakdown &amp; Towing</span>
        </div>
        <a class="btn-dial" href="tel:1033">1033</a>
      </div>
      <div class="emergency-matrix-cell">
        <div class="emergency-matrix-text">
          <span class="emergency-matrix-label">Women Helpline</span>
          <span class="emergency-matrix-desc">24x7 Safety Powerline</span>
        </div>
        <a class="btn-dial" href="tel:1090">1090</a>
      </div>
      <div class="emergency-matrix-cell">
        <div class="emergency-matrix-text">
          <span class="emergency-matrix-label">Accident Relief</span>
          <span class="emergency-matrix-desc">Emergency Road Medical</span>
        </div>
        <a class="btn-dial" href="tel:1073">1073</a>
      </div>
    </div>
  </section>

  <!-- Bottom Ad Slot -->
  <AdSlot slotId="8460038937" label="Sponsored" />

  <script define:vars={{ allSearchEntries }}>
    const input = document.getElementById('national-search-input');
    const dropdown = document.getElementById('search-dropdown-menu');

    if (input && dropdown) {
      input.addEventListener('input', (e) => {
        const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
        if (!q || q.length < 2) {
          dropdown.style.display = 'none';
          dropdown.innerHTML = '';
          return;
        }

        const matches = allSearchEntries.filter((item) =>
          item.keywords.includes(q) || item.title.toLowerCase().includes(q)
        ).slice(0, 8);

        if (matches.length === 0) {
          dropdown.innerHTML = `
            <div style="padding:1rem 1.15rem;font-size:0.88rem;color:var(--ink-muted);text-align:center;">
              No bus stands matched "<strong>${q}</strong>". Try searching a city name or select a state above.
            </div>
          `;
          dropdown.style.display = 'block';
          return;
        }

        dropdown.innerHTML = matches.map((m) => `
          <a class="search-result-item" href="${m.url}">
            <div>
              <div class="search-item-title">${m.title}</div>
              <div class="search-item-sub">${m.sub}</div>
            </div>
            <span class="search-item-action">${m.action}</span>
          </a>
        `).join('');
        dropdown.style.display = 'block';
      });

      document.addEventListener('click', (ev) => {
        if (!input.contains(ev.target as Node) && !dropdown.contains(ev.target as Node)) {
          dropdown.style.display = 'none';
        }
      });
    }
  </script>

</Base>
