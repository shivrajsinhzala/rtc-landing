---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { STATES } from '../../config/states.mjs';
import { DEPOTS as UP_DEPOTS, depotSlug } from '../../data/uttar-pradesh/depots.data.mjs';
import { DEPOTS as MH_DEPOTS } from '../../data/maharashtra/depots.data.mjs';
import { DEPOTS as RJ_DEPOTS } from '../../data/rajasthan/depots.data.mjs';
import { DEPOTS as HR_DEPOTS } from '../../data/haryana/depots.data.mjs';
import { DEPOTS as HP_DEPOTS } from '../../data/himachal-pradesh/depots.data.mjs';
import { DEPOTS as UK_DEPOTS } from '../../data/uttarakhand/depots.data.mjs';
import { DEPOTS as PB_DEPOTS } from '../../data/punjab/depots.data.mjs';
import { DEPOTS as GJ_DEPOTS } from '../../data/gujarat/depots.data.mjs';
import { ROUTES } from '../../data/routes.data.mjs';

export function getStaticPaths() {
  const sources = {
    'uttar-pradesh': UP_DEPOTS,
    'maharashtra': MH_DEPOTS,
    'rajasthan': RJ_DEPOTS,
    'haryana': HR_DEPOTS,
    'himachal-pradesh': HP_DEPOTS,
    'uttarakhand': UK_DEPOTS,
    'punjab': PB_DEPOTS,
    'gujarat': GJ_DEPOTS,
  };
  return Object.keys(sources).map((stateId) => ({
    params: { state: stateId },
    props: { state: STATES[stateId], depots: sources[stateId] },
  }));
}

const { state, depots } = Astro.props;
const title = `${state.corporation} Bus Station Contact Numbers & Timetables — ${state.name}`;
const description = `Directory of ${state.corporation} (${state.corporationFull}) bus stand enquiry phone numbers across ${state.name}. Reference phone numbers for all ${depots.length} regional transport divisions, bus timetables & 24x7 helpline.`;
const path = `/${state.slug}`;

const stateCodes: Record<string, string> = {
  'uttar-pradesh': 'UP',
  'maharashtra': 'MH',
  'rajasthan': 'RJ',
  'haryana': 'HR',
  'himachal-pradesh': 'HP',
  'uttarakhand': 'UK',
  'punjab': 'PB',
  'gujarat': 'GJ',
};

const code = stateCodes[state.id] || 'IN';
const breadcrumbs = [
  { label: 'State RTCs', href: '/states' },
  { label: state.name, href: path },
];

const totalStands = depots.reduce((acc, d) => acc + d.stands.length, 0);
const stateRoutes = ROUTES.filter((r) => r.stateId === state.id);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `https://rtc.shivrajsinh.in${path}`,
    about: { '@type': 'Place', name: state.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rtc.shivrajsinh.in/' },
      { '@type': 'ListItem', position: 2, name: 'State RTCs', item: 'https://rtc.shivrajsinh.in/states' },
      { '@type': 'ListItem', position: 3, name: state.name, item: `https://rtc.shivrajsinh.in${path}` },
    ],
  },
];
---

<Base title={title} description={description} path={path} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>

  <div class="wrap" style="padding-top:1rem;padding-bottom:3rem;">

    <!-- State Hero & Summary Header -->
    <section style="margin-bottom:2rem;">
      <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.75rem;">
        <span class="state-chip">{code}</span>
        <span style="font-family:var(--font-mono);font-size:0.75rem;font-weight:700;color:var(--primary-blue);text-transform:uppercase;letter-spacing:0.04em;">
          {state.corporation} Directory Reference
        </span>
      </div>
      <h1 class="section-title" style="font-size:2.25rem;margin-bottom:0.5rem;">
        {state.corporation} Bus Station Contact Numbers &amp; Enquiry
      </h1>
      <p class="section-subtitle" style="font-size:1.05rem;line-height:1.6;max-width:760px;margin-bottom:1.5rem;">
        Directory of bus stand inquiry telephone numbers, station master control desks, and regional transport divisions operated by <strong>{state.corporationFull} ({state.corporation})</strong> across <strong>{state.name}</strong>.
      </p>

      <!-- Key Stats Spec Strip -->
      <div class="route-spec-grid" style="margin-top:1rem;margin-bottom:1.5rem;">
        <div class="route-spec-cell">
          <div class="route-spec-label">Divisional Stations</div>
          <div class="route-spec-value">{depots.length} Divisions</div>
        </div>
        <div class="route-spec-cell">
          <div class="route-spec-label">Bus Terminals</div>
          <div class="route-spec-value">{totalStands} Stands</div>
        </div>
        <div class="route-spec-cell">
          <div class="route-spec-label">24×7 Passenger Helpline</div>
          <div class="route-spec-value" style="color:var(--primary-blue);">{state.helpline.primary}</div>
        </div>
        <div class="route-spec-cell">
          <div class="route-spec-label">Sourcing Sourced</div>
          <div class="route-spec-value" style="font-size:0.95rem;color:var(--success);">Published Records</div>
        </div>
      </div>

      <!-- Quick Action Helpline Strip -->
      <div class="dial-action-strip" style="margin:1rem 0;">
        <div class="dial-strip-header">
          <div class="dial-strip-title">{state.corporation} Statewide Central Customer Service</div>
          <div class="dial-strip-sub">24×7 toll-free inquiry desk for bus timings, grievance, and station control</div>
        </div>
        <div class="call-button-group">
          <a class="btn-dial" href={`tel:${state.helpline.primary.replace(/[^0-9]/g, '')}`}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Dial Helpline: {state.helpline.primary}</span>
          </a>
          {state.officialSite && (
            <a class="btn-dial secondary" href={state.officialSite} target="_blank" rel="noopener noreferrer">
              <span>Official Portal ({state.officialSite.replace('https://', '')})</span>
            </a>
          )}
          <a class="btn-dial secondary" href="/#national-search-input">
            <span>Search Another Station</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Above-The-Fold Ad Slot -->
    <AdSlot slotId="8460038937" label="Sponsored Advertisement" />

    <!-- Popular Intercity Routes for this state -->
    {stateRoutes.length > 0 && (
      <section aria-labelledby="state-routes-heading" style="margin:2.5rem 0;">
        <div class="section-heading-row">
          <div>
            <h2 class="section-title" id="state-routes-heading" style="font-size:1.55rem;">
              Popular {state.name} Bus Timetables &amp; Routes
            </h2>
            <p class="section-subtitle">Direct point-to-point departure frequencies, operating distance, and starting fares:</p>
          </div>
          <a class="section-link" href={`/${state.slug}/routes`}>
            <span>All {state.name} Routes ({stateRoutes.length})</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>

        <div class="routes-grid">
          {stateRoutes.map((r) => (
            <a class="route-card" href={`/${state.slug}/routes/${r.slug}`}>
              <div>
                <div class="route-card-header">
                  <span class="route-card-operator">{r.corporation} Express</span>
                  <span class="route-card-duration">{r.durationHours}</span>
                </div>
                <h3 class="route-card-corridor" style="font-size:1.15rem;">{r.originCity} ⇄ {r.destinationCity}</h3>
                <p class="route-card-specs">
                  {r.distanceKm} km via {r.highway} · {r.frequency}
                  <br />
                  First bus: {r.firstBus} · Night: {r.lastBus}
                </p>
              </div>
              <div class="route-card-footer">
                <span class="route-card-fare">From {r.fares[0].price}</span>
                <span class="route-card-action">View timetable</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Divisional Stations Directory Grid -->
    <section aria-labelledby="divisions-heading" style="margin:2.5rem 0;">
      <div class="section-heading-row">
        <div>
          <h2 class="section-title" id="divisions-heading" style="font-size:1.55rem;">
            {state.name} Transport Divisions &amp; Bus Stands
          </h2>
          <p class="section-subtitle">
            Select a station to access direct enquiry counter phone numbers and platform details:
          </p>
        </div>
      </div>

      <!-- Instant Filter Bar -->
      <div style="position:relative;margin:1rem 0 1.5rem;">
        <input
          type="search"
          id="depot-filter-input"
          class="hero-search-input"
          style="background:var(--bg-surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0 1rem;height:44px;"
          placeholder={`Filter ${state.name} stations (e.g. ${depots.slice(0, 3).map(d => d.city).join(', ')})...`}
          aria-label={`Filter ${state.name} bus stations`}
          autocomplete="off"
        />
        <div id="search-empty-state" style="display:none;padding:1.5rem;text-align:center;color:var(--slate-muted);background:var(--bg-surface);border:1px solid var(--border);border-radius:var(--radius-sm);margin-top:0.5rem;">
          <p style="font-weight:600;color:var(--ink);">No stations matched your filter</p>
          <p style="font-size:0.85rem;margin-top:0.25rem;">Try another spelling or call the toll-free helpline at {state.helpline.primary}</p>
        </div>
      </div>

      <div id="depot-grid-container" class="rtc-grid" style="grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));">
        {depots.map((d) => {
          const name = d.alsoKnownAs ? d.region : d.city[0].toUpperCase() + d.city.slice(1);
          const standCount = d.stands.length;
          const mainNumber = d.stands[0].numbers[0];
          const searchKeywords = `${name} ${d.city} ${d.region} ${d.alsoKnownAs || ''} ${d.stands.map(s => s.label).join(' ')}`.toLowerCase();
          return (
            <a class="rtc-card depot-card-item" href={`/${state.slug}/${depotSlug(d.city)}`} data-search={searchKeywords} aria-label={`${name} bus station contact details`}>
              <div>
                <div class="rtc-card-top">
                  <span class="state-chip">{name}</span>
                  <span style="font-size:0.75rem;font-weight:600;color:var(--slate-muted);">
                    {standCount} {standCount === 1 ? 'Stand' : 'Stands'}
                  </span>
                </div>
                <h3 class="rtc-card-title" style="font-size:1.05rem;">{name} Bus Station</h3>
                <p style="font-size:0.82rem;color:var(--slate-muted);margin-top:0.2rem;">
                  {d.region} Transport Division
                </p>
              </div>
              <div class="rtc-card-meta">
                <span style="font-family:var(--font-mono);font-weight:600;color:var(--primary-blue);">
                  Desk: {mainNumber}
                </span>
                <span style="color:var(--primary-blue);font-weight:600;">Details</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Mid-Content Ad Slot -->
    <AdSlot slotId="8460038937" label="Advertisement" />

    <!-- Trust & Verification Notice -->
    <section class="trust-statement-box" aria-label="Verification Notice">
      <h3 class="trust-statement-title">Public Directory Verification Notice</h3>
      <p class="trust-statement-text">
        RTC Portal is an independent public directory compiled from published state transport records. Phone lines and inquiry counter staffing are maintained directly by {state.corporation}. During peak travel hours or festival rushes, local depot numbers may be busy; in such cases, commuters are advised to call the 24×7 central toll-free helpline at <strong>{state.helpline.primary}</strong>.
      </p>
    </section>

    <!-- Pre-Footer Ad Slot -->
    <AdSlot slotId="8460038937" label="Sponsored" />

  </div>

  <script>
    const input = document.getElementById('depot-filter-input');
    const items = document.querySelectorAll('.depot-card-item');
    const empty = document.getElementById('search-empty-state');

    if (input) {
      input.addEventListener('input', (e) => {
        const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
        let count = 0;
        items.forEach((card) => {
          const hay = card.getAttribute('data-search') || '';
          const match = !q || hay.includes(q);
          (card as HTMLElement).style.display = match ? '' : 'none';
          if (match) count++;
        });
        if (empty) empty.style.display = count === 0 ? 'block' : 'none';
      });
    }
  </script>

</Base>
