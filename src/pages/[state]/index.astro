---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { STATES } from '../../config/states.mjs';
import { DEPOTS as UP_DEPOTS, depotSlug } from '../../data/uttar-pradesh/depots.data.mjs';
import { DEPOTS as MH_DEPOTS } from '../../data/maharashtra/depots.data.mjs';
import { DEPOTS as RJ_DEPOTS } from '../../data/rajasthan/depots.data.mjs';
import { DEPOTS as HR_DEPOTS } from '../../data/haryana/depots.data.mjs';
import { DEPOTS as HP_DEPOTS } from '../../data/himachal-pradesh/depots.data.mjs';
import { DEPOTS as UK_DEPOTS } from '../../data/uttarakhand/depots.data.mjs';
import { DEPOTS as PB_DEPOTS } from '../../data/punjab/depots.data.mjs';
import { DEPOTS as GJ_DEPOTS } from '../../data/gujarat/depots.data.mjs';
import { ROUTES } from '../../data/routes.data.mjs';

export function getStaticPaths() {
  const sources = {
    'uttar-pradesh': UP_DEPOTS,
    'maharashtra': MH_DEPOTS,
    'rajasthan': RJ_DEPOTS,
    'haryana': HR_DEPOTS,
    'himachal-pradesh': HP_DEPOTS,
    'uttarakhand': UK_DEPOTS,
    'punjab': PB_DEPOTS,
    'gujarat': GJ_DEPOTS,
  };
  return Object.keys(sources).map((stateId) => ({
    params: { state: stateId },
    props: { state: STATES[stateId], depots: sources[stateId] },
  }));
}

const { state, depots } = Astro.props;
const title = `${state.corporation} Bus Station Contact Numbers & Timetables — All Depots (${state.name})`;
const description = `Official directory of ${state.corporation} (${state.corporationFull}) bus stand enquiry phone numbers across ${state.name}. Verified phone numbers for all ${depots.length} regional transport divisions, intercity bus timetables & 24x7 helpline.`;
const path = `/${state.slug}`;

const breadcrumbs = [
  { label: state.name, href: path }
];

const totalStands = depots.reduce((acc, d) => acc + d.stands.length, 0);
const stateRoutes = ROUTES.filter((r) => r.stateId === state.id);

const heroImg =
  state.id === 'uttar-pradesh'
    ? '/images/hero-upsrtc.jpg'
    : state.id === 'maharashtra'
    ? '/images/hero-msrtc.jpg'
    : '/images/hero-national.jpg';

const heroTag =
  state.id === 'uttar-pradesh'
    ? 'UPSRTC Express Network'
    : state.id === 'maharashtra'
    ? 'MSRTC ST Network'
    : state.id === 'rajasthan'
    ? 'RSRTC Express Network'
    : 'Haryana Roadways Network';

const heroSub =
  state.id === 'uttar-pradesh'
    ? 'Yamuna & Agra Expressways · Janrath & Platinum Fleet'
    : state.id === 'maharashtra'
    ? 'Mumbai-Pune Expressway · Shivshahi & Ashwamedh Fleet'
    : state.id === 'rajasthan'
    ? 'Delhi-Jaipur Highway · Volvo & Super Express Fleet'
    : 'GT Road Corridor · Haryana Shakti & Volvo Fleet';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `https://rtc.shivrajsinh.in${path}`,
    about: { '@type': 'Place', name: state.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rtc.shivrajsinh.in/' },
      { '@type': 'ListItem', position: 2, name: state.name, item: `https://rtc.shivrajsinh.in${path}` },
    ],
  },
];
---

<Base title={title} description={description} path={path} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>

  <section class="hero-split">
    <div>
      <div style="font-size:0.8rem;font-weight:700;color:var(--transit-amber);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.35rem;">Official State Transport Directory · {state.name}</div>
      <h1 class="page-title">{state.corporation} Bus Station Contact Numbers &amp; Enquiry</h1>
      <p class="page-lede">
        Official enquiry phone numbers for all <strong>{depots.length} transport divisions</strong> and <strong>{totalStands} bus terminals</strong> operated by {state.corporationFull} ({state.corporation}) across {state.name}. Sourced directly from published government transit records.
      </p>
    </div>

    <div class="hero-visual-card">
      <img
        src={heroImg}
        alt={`${state.corporation} (${state.corporationFull}) Regional Express Bus Fleet and Highway Network`}
        class="hero-visual-img"
        width="1400"
        height="787"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-visual-overlay">
        <div>
          <div class="hero-visual-tag">{heroTag}</div>
          <div class="hero-visual-sub">{heroSub}</div>
        </div>
        <span style="font-size:0.75rem;padding:0.2rem 0.6rem;background:rgba(255,255,255,0.15);backdrop-filter:blur(4px);border-radius:4px;font-weight:700;">2026 Verified</span>
      </div>
    </div>
  </section>

  <!-- Institutional Trust & Stats Strip -->
  <div class="trust-strip">
    <div class="trust-item">
      <div class="trust-icon-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/></svg>
      </div>
      <div>
        <div class="trust-title">{depots.length} Transport Divisions</div>
        <div class="trust-sub">Regional headquarters across {state.name}</div>
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
      </div>
      <div>
        <div class="trust-title">{totalStands} Bus Terminals</div>
        <div class="trust-sub">Direct enquiry counter numbers</div>
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </div>
      <div>
        <div class="trust-title">24x7 Toll-Free</div>
        <div class="trust-sub">{state.helpline.primary}</div>
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      </div>
      <div>
        <div class="trust-title">1-Tap Dial</div>
        <div class="trust-sub">Zero redirects or ads on click</div>
      </div>
    </div>
  </div>

  <!-- Central Statewide Helpline Card -->
  <section class="action-card" aria-label="Statewide Helpline">
    <div class="action-card-header">
      <span class="action-card-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>24x7 Central {state.corporation} Passenger Support</span>
      </span>
      <span class="action-card-subtitle">Statewide Toll-Free Helpline</span>
    </div>

    <div class="call-button-group">
      <a class="btn-call" href={`tel:${state.helpline.primary.replace(/[^0-9]/g, '')}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>Dial Toll-Free: {state.helpline.primary}</span>
      </a>
      <a class="btn-call secondary" href={state.officialSite} target="_blank" rel="noopener noreferrer">
        <span>Official Portal ({state.officialSite.replace('https://', '')}) ↗</span>
      </a>
    </div>
  </section>

  <!-- Above-The-Fold Ad Slot -->
  <AdSlot slotId="8460038937" label="Sponsored Advertisement" />

  <!-- Popular Intercity Express Bus Routes -->
  {stateRoutes.length > 0 && (
    <section aria-labelledby="state-routes-heading" style="margin-bottom:2.5rem;">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;">
        <div>
          <h2 class="section-h2" id="state-routes-heading" style="margin-bottom:0.25rem;">Popular {state.name} Bus Timetables &amp; Routes</h2>
          <p style="color:var(--ink-light);font-size:0.9rem;">Direct point-to-point departure schedules, ticket prices, and station enquiry numbers:</p>
        </div>
        <a class="nav-pill-btn" href={`/${state.slug}/routes`} style="font-size:0.8rem;">
          <span>All {state.name} Routes ({stateRoutes.length}) →</span>
        </a>
      </div>

      <div class="sibling-grid" style="grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));">
        {stateRoutes.map((r) => (
          <a class="sibling-link" href={`/${state.slug}/routes/${r.slug}`} style="padding:1rem;display:flex;flex-direction:column;justify-content:space-between;">
            <div>
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.35rem;">
                <span style="font-size:0.75rem;font-weight:700;color:var(--cobalt);text-transform:uppercase;">{r.corporation} Express</span>
                <span style="font-size:0.72rem;background:var(--emerald-light);color:var(--emerald);padding:0.1rem 0.4rem;border-radius:4px;font-weight:700;">{r.durationHours}</span>
              </div>
              <div style="font-size:1.02rem;font-weight:700;color:var(--ink);">{r.originCity} to {r.destinationCity}</div>
              <div style="font-size:0.8rem;color:var(--ink-light);margin-top:0.25rem;">{r.frequency} · First {r.firstBus}, Last {r.lastBus}</div>
            </div>
            <div style="margin-top:0.75rem;padding-top:0.6rem;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;font-size:0.8rem;">
              <span style="font-weight:700;color:var(--emerald);">From {r.fares[0].price}</span>
              <span style="color:var(--cobalt);font-weight:700;">View Timetable →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Divisional Directory Grid -->
  <section aria-labelledby="divisions-heading">
    <h2 class="section-h2" id="divisions-heading">{state.name} Transport Divisions &amp; Bus Stands</h2>
    <p style="color:var(--ink-light);font-size:0.9rem;margin-bottom:1rem;">
      Select your district or regional headquarters to access verified enquiry counter phone numbers and platform details:
    </p>

    <!-- Instant Search & Filter Bar -->
    <div class="search-box-wrap" style="margin: 1rem 0 1.5rem;">
      <div class="search-input-group">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="depot-filter-input" class="search-input" placeholder={`Filter ${state.name} depots (e.g. Lucknow, Agra, Prayagraj, Varanasi)...`} aria-label={`Filter ${state.name} bus stations`} autocomplete="off" />
      </div>
      <div id="search-empty-state" class="search-empty">
        <p style="font-weight:600;color:var(--ink);">No bus stations found matching your search</p>
        <p style="font-size:0.85rem;margin-top:0.35rem;">Try typing another city name or call the 24x7 statewide helpline at <a href={`tel:${state.helpline.primary.replace(/[^0-9]/g, '')}`} style="color:var(--cobalt);font-weight:700;">{state.helpline.primary}</a></p>
      </div>
    </div>

    <div id="depot-grid-container" class="sibling-grid" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));">
      {depots.map((d) => {
        const name = d.alsoKnownAs ? d.region : d.city[0].toUpperCase() + d.city.slice(1);
        const standCount = d.stands.length;
        const mainNumber = d.stands[0].numbers[0];
        const searchKeywords = `${name} ${d.city} ${d.region} ${d.alsoKnownAs || ''} ${d.stands.map(s => s.label).join(' ')}`.toLowerCase();
        return (
          <a class="sibling-link depot-card-item" href={`/${state.slug}/${depotSlug(d.city)}`} data-search={searchKeywords} style={`padding:1.1rem;border-left: 3px solid ${state.id === 'uttar-pradesh' ? '#1d4ed8' : '#b91c1c'};`}>
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.4rem;">
              <span style="font-size:1.05rem;font-weight:700;color:var(--ink);">{name}</span>
              <span style={`font-size:0.75rem;padding:0.2rem 0.5rem;background:${state.id === 'uttar-pradesh' ? 'var(--cobalt-light)' : '#fef2f2'};color:${state.id === 'uttar-pradesh' ? 'var(--cobalt)' : '#b91c1c'};border-radius:4px;font-weight:700;`}>
                {standCount} {standCount === 1 ? 'Stand' : 'Stands'}
              </span>
            </div>
            <div style="font-size:0.82rem;color:var(--ink-light);font-variant-numeric:tabular-nums;display:flex;align-items:center;gap:0.35rem;">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>Desk: <strong style={`color:${state.id === 'uttar-pradesh' ? 'var(--cobalt)' : '#b91c1c'};`}>{mainNumber}</strong></span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <script>
    const input = document.getElementById('depot-filter-input');
    const items = document.querySelectorAll('.depot-card-item');
    const empty = document.getElementById('search-empty-state');

    if (input) {
      input.addEventListener('input', (e) => {
        const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
        let count = 0;
        items.forEach((card) => {
          const hay = card.getAttribute('data-search') || '';
          const match = !q || hay.includes(q);
          (card as HTMLElement).style.display = match ? '' : 'none';
          if (match) count++;
        });
        if (empty) empty.style.display = count === 0 ? 'block' : 'none';
      });
    }
  </script>

  <!-- Mid-Content Ad Slot -->
  <AdSlot slotId="8460038937" label="Advertisement" />

  <!-- Important Information & Guidelines -->
  <section class="action-card" style="border-left-color: var(--navy);margin-top:2.5rem;" aria-label="Important Information">
    <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:0.6rem;color:var(--ink);">Important Passenger Guidelines</h3>
    <ul style="padding-left:1.25rem;color:var(--ink-muted);font-size:0.9rem;display:flex;flex-direction:column;gap:0.4rem;">
      <li><strong>Advance Online Booking:</strong> Passengers can reserve seats for premium (Shivshahi, AC Shatabdi, Janrath, Sleeper) and Ordinary express services up to 30 days in advance on the official {state.corporation} portal.</li>
      <li><strong>Luggage Assistance:</strong> For lost baggage or property left behind on {state.corporation} buses, immediately register a complaint with the destination station master or call {state.helpline.primary}.</li>
      <li><strong>Women Passenger Safety:</strong> 24x7 dedicated emergency security support is available via Women Helpline (1090) and Police Emergency (112).</li>
    </ul>
  </section>

  <!-- Pre-Footer Ad Slot -->
  <AdSlot slotId="8460038937" label="Sponsored" />

</Base>
