---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { STATES } from '../../../config/states.mjs';
import { ROUTES } from '../../../data/routes.data.mjs';

export function getStaticPaths() {
  const stateIds = ['uttar-pradesh', 'maharashtra', 'rajasthan', 'haryana', 'himachal-pradesh', 'uttarakhand', 'punjab'];
  return stateIds.map((stateId) => ({
    params: { state: stateId },
    props: {
      state: STATES[stateId],
      routes: ROUTES.filter((r) => r.stateId === stateId),
    },
  }));
}

const { state, routes } = Astro.props;
const title = `${state.corporation} Bus Timetables, Fares & Intercity Routes — ${state.name}`;
const description = `Directory reference for ${state.corporation} (${state.corporationFull}) intercity bus timetables, ticket prices, departure frequency, and first/last bus schedules connecting ${state.name}.`;
const path = `/${state.slug}/routes`;

const breadcrumbs = [
  { label: 'State RTCs', href: '/states' },
  { label: state.name, href: `/${state.slug}` },
  { label: 'Routes', href: path },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `https://rtc.shivrajsinh.in${path}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rtc.shivrajsinh.in/' },
      { '@type': 'ListItem', position: 2, name: 'State RTCs', item: 'https://rtc.shivrajsinh.in/states' },
      { '@type': 'ListItem', position: 3, name: state.name, item: `https://rtc.shivrajsinh.in/${state.slug}` },
      { '@type': 'ListItem', position: 4, name: 'Routes', item: `https://rtc.shivrajsinh.in${path}` },
    ],
  },
];
---

<Base title={title} description={description} path={path} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>

  <div class="wrap" style="padding-top:1rem;padding-bottom:3rem;">

    <header style="margin-bottom:2rem;">
      <div style="font-family:var(--font-mono);font-size:0.75rem;font-weight:700;color:var(--primary-blue);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.35rem;">
        {state.corporation} Intercity Network · {state.name}
      </div>
      <h1 class="section-title" style="font-size:2.2rem;margin-bottom:0.4rem;">
        {state.corporation} Bus Timetables &amp; Route Fares
      </h1>
      <p class="section-subtitle" style="font-size:1.05rem;line-height:1.6;max-width:760px;">
        Departure schedules, distance, travel duration, and starting ticket fares for major <strong>{state.corporation}</strong> highway corridors connecting <strong>{state.name}</strong>.
      </p>
    </header>

    <!-- Above-The-Fold Ad Slot -->
    <AdSlot slotId="8460038937" label="Sponsored Advertisement" />

    <!-- Routes Directory Grid -->
    <section aria-labelledby="routes-heading" style="margin:2.5rem 0;">
      <div class="section-heading-row">
        <div>
          <h2 class="section-title" id="routes-heading" style="font-size:1.55rem;">
            Major Express Bus Corridors ({routes.length})
          </h2>
          <p class="section-subtitle">
            Select any corridor to view departure timings, ticket prices, and platform enquiry phone desks:
          </p>
        </div>
        <a class="section-link" href={`/${state.slug}`}>
          <span>{state.name} Depot Contacts</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="routes-grid">
        {routes.map((r) => (
          <a class="route-card" href={`/${state.slug}/routes/${r.slug}`}>
            <div>
              <div class="route-card-header">
                <span class="route-card-operator">{r.corporation} Express</span>
                <span class="route-card-duration">{r.durationHours}</span>
              </div>
              <h3 class="route-card-corridor" style="font-size:1.15rem;">
                {r.originCity} ⇄ {r.destinationCity}
              </h3>
              <p class="route-card-specs">
                {r.distanceKm} km via {r.highway} · {r.frequency}
                <br />
                First bus: {r.firstBus} · Night service: {r.lastBus}
              </p>
            </div>
            <div class="route-card-footer">
              <span class="route-card-fare">From {r.fares[0].price}</span>
              <span class="route-card-action">Full Timetable</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Mid-Content Ad Slot -->
    <AdSlot slotId="8460038937" label="Advertisement" />

    <!-- Statewide Booking & Support Strip -->
    <section class="dial-action-strip" style="margin:2.5rem 0;" aria-label="Official Booking & Helpline">
      <div class="dial-strip-header">
        <div class="dial-strip-title">{state.corporation} Passenger Booking Support</div>
        <div class="dial-strip-sub">24×7 customer service desk and official portal</div>
      </div>
      <p style="font-size:0.9rem;color:var(--slate-muted);line-height:1.6;margin-bottom:1rem;">
        Tickets for express, sleeper, and AC coaches can be reserved up to 30 days in advance on the official {state.corporation} portal. For phone inquiries, duty controller confirmation, or seat availability, dial the 24×7 toll-free helpline:
      </p>
      <div class="call-button-group">
        <a class="btn-dial" href={`tel:${state.helpline.primary.replace(/[^0-9]/g, '')}`}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Call Helpline: {state.helpline.primary}</span>
        </a>
        {state.officialSite && (
          <a class="btn-dial secondary" href={state.officialSite} target="_blank" rel="noopener noreferrer">
            <span>Official Portal ({state.officialSite.replace('https://', '')})</span>
          </a>
        )}
        <a class="btn-dial secondary" href="/timetables">
          <span>All National Timetables</span>
        </a>
      </div>
    </section>

    <!-- Pre-Footer Ad Slot -->
    <AdSlot slotId="8460038937" label="Sponsored" />

  </div>

</Base>
