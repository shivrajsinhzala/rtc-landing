---
import { SITE } from '../config/states.mjs';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  /** Path with leading slash, e.g. '/uttar-pradesh/agra-bus-station-contact-number'. */
  path: string;
  jsonLd?: unknown[];
  htmlLang?: string;
  breadcrumbs?: { label: string; href: string }[];
}

const {
  title,
  description,
  keywords = 'roadways bus enquiry number, bus stand contact number, roadways bus time table, bus ticket price, यूपी रोडवेज बस टाइम टेबल, रोडवेज बस समय सारणी, बस स्टैंड पूछताछ नंबर, एसटी बस चौकशी क्रमांक, rtc enquiry number',
  path,
  jsonLd = [],
  htmlLang = 'en-IN',
  breadcrumbs = []
} = Astro.props;
const AD_CLIENT = 'ca-pub-7164999486301748';
const canonical = `${SITE}${path}`;

const baseJsonLd: unknown[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RTC Portal',
    url: `${SITE}/`,
    description: 'National State Road Transport Corporation Bus Station Helplines & Enquiry Directory.',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE}/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'RTC Portal',
    url: `${SITE}/`,
    logo: `${SITE}/icons/logo.svg`,
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: '1800-180-2877',
        contactType: 'UPSRTC Passenger Helpline',
        areaServed: 'IN-UP',
        availableLanguage: ['Hindi', 'English'],
      },
      {
        '@type': 'ContactPoint',
        telephone: '1800-22-1250',
        contactType: 'MSRTC Passenger Helpline',
        areaServed: 'IN-MH',
        availableLanguage: ['Marathi', 'Hindi', 'English'],
      },
      {
        '@type': 'ContactPoint',
        telephone: '1800-2000-103',
        contactType: 'RSRTC Passenger Helpline',
        areaServed: 'IN-RJ',
        availableLanguage: ['Hindi', 'English'],
      },
      {
        '@type': 'ContactPoint',
        telephone: '1800-180-2345',
        contactType: 'Haryana Roadways Passenger Helpline',
        areaServed: 'IN-HR',
        availableLanguage: ['Hindi', 'English'],
      },
      {
        '@type': 'ContactPoint',
        telephone: '112',
        contactType: 'National All-India Emergency Service',
        areaServed: 'IN',
      },
    ],
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang={htmlLang} data-theme="auto">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="google-adsense-account" content={AD_CLIENT} />

<!-- AdSense Script -->
<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${AD_CLIENT}`} crossorigin="anonymous"></script>

<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1" />

<!-- OpenGraph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="RTC Portal" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={`${SITE}/icons/logo.svg`} />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Theme Colors & Favicons -->
<meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
<link rel="icon" href="/icons/logo.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<!-- JSON-LD Structured Data -->
{baseJsonLd.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
</head>
<body>

<!-- Institutional Top Notice Bar -->
<div class="gov-notice-bar">
  <div class="wrap gov-notice-content">
    <div class="gov-flag-badge">
      <svg width="14" height="10" viewBox="0 0 24 16" fill="none" aria-hidden="true">
        <rect width="24" height="5.33" fill="#FF9933"/>
        <rect y="5.33" width="24" height="5.34" fill="#FFFFFF"/>
        <rect y="10.67" width="24" height="5.33" fill="#138808"/>
        <circle cx="12" cy="8" r="2.2" stroke="#000080" stroke-width="0.7"/>
      </svg>
      <span>National State Road Transport Helpline Directory · Public Utility</span>
    </div>
    <div class="gov-right-links">
      <a class="gov-helpline-quick" href="tel:112">Emergency: 112</a>
      <a class="gov-helpline-quick" href="tel:1033">Highway Helpline: 1033</a>
    </div>
  </div>
</div>

<!-- Main Site Header -->
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand-wrap" href="/" aria-label="RTC Portal Home">
      <img class="brand-logo" src="/icons/logo.svg" alt="RTC Portal Logo" width="40" height="40" />
      <div class="brand-titles">
        <span class="brand-title">RTC Portal</span>
        <span class="brand-tagline">State Road Transport Helplines &amp; Depots</span>
      </div>
    </a>

    <nav class="header-nav" aria-label="Main Navigation">
      <a class="nav-state-pill" href="/uttar-pradesh"><span class="code">UP</span><span>Roadways</span></a>
      <a class="nav-state-pill" href="/maharashtra"><span class="code">MH</span><span>ST Bus</span></a>
      <a class="nav-state-pill" href="/rajasthan"><span class="code">RJ</span><span>RSRTC</span></a>
      <a class="nav-state-pill" href="/haryana"><span class="code">HR</span><span>Roadways</span></a>
      <a class="nav-state-pill" href="/himachal-pradesh"><span class="code">HP</span><span>HRTC</span></a>
      <a class="nav-state-pill" href="/uttarakhand"><span class="code">UK</span><span>UTC</span></a>
      <a class="nav-state-pill" href="/punjab"><span class="code">PB</span><span>PUNBUS</span></a>
      <a class="nav-state-pill" href="/gujarat"><span class="code">GJ</span><span>GSRTC</span></a>
    </nav>
  </div>
</header>

<!-- Breadcrumbs if provided -->
{breadcrumbs.length > 0 && (
  <nav class="wrap breadcrumbs-nav" aria-label="Breadcrumbs">
    <ol class="breadcrumbs-list">
      <li><a href="/">Home</a></li>
      {breadcrumbs.map((crumb, idx) => (
        <>
          <li class="breadcrumbs-sep" aria-hidden="true">›</li>
          <li>
            {idx === breadcrumbs.length - 1 ? (
              <span class="breadcrumbs-current" aria-current="page">{crumb.label}</span>
            ) : (
              <a href={crumb.href}>{crumb.label}</a>
            )}
          </li>
        </>
      ))}
    </ol>
  </nav>
)}

<main class="wrap main-content">
  <slot />
</main>

<!-- Institutional Footer -->
<footer class="site-footer">
  <div class="wrap footer-top">
    <div>
      <div class="footer-brand-title">
        <img src="/icons/logo.svg" alt="" width="24" height="24" aria-hidden="true" />
        <span>RTC Portal</span>
      </div>
      <p class="footer-brand-desc">
        Authoritative national directory of State Road Transport Corporation (RTC) bus stand inquiry desks, station master telephone lines, and intercity bus timetables. Sourced directly from official published transport records.
      </p>
    </div>

    <div>
      <h3 class="footer-heading">Emergency &amp; Highway</h3>
      <ul class="footer-links">
        <li><a href="tel:112">National Emergency: 112</a></li>
        <li><a href="tel:1033">National Highway: 1033</a></li>
        <li><a href="tel:1090">Women Powerline: 1090</a></li>
        <li><a href="tel:1073">Road Accident Helpline: 1073</a></li>
      </ul>
    </div>

    <div>
      <h3 class="footer-heading">State Transport Hubs</h3>
      <ul class="footer-links">
        <li><a href="/uttar-pradesh">Uttar Pradesh (UPSRTC)</a></li>
        <li><a href="/maharashtra">Maharashtra (MSRTC)</a></li>
        <li><a href="/rajasthan">Rajasthan (RSRTC)</a></li>
        <li><a href="/haryana">Haryana Roadways</a></li>
        <li><a href="/himachal-pradesh">Himachal Pradesh (HRTC)</a></li>
        <li><a href="/uttarakhand">Uttarakhand (UTC)</a></li>
        <li><a href="/punjab">Punjab (PUNBUS / PRTC)</a></li>
        <li><a href="/gujarat">Gujarat (GSRTC)</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>
      © 2026 RTC Portal. Independent public directory. Not affiliated with or endorsed by UPSRTC, MSRTC, or the Ministry of Road Transport and Highways.
    </p>
    <div>
      <a href="/sitemap-index.xml">Sitemap</a>
    </div>
  </div>
</footer>

<script>
  // Resilient multi-slot AdSense binding
  function initAds() {
    const slots = document.querySelectorAll('ins.adsbygoogle');
    slots.forEach((slot) => {
      if (slot.dataset.bound === '1') return;
      slot.dataset.bound = '1';
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch {}
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAds);
  } else {
    initAds();
  }
</script>

</body>
</html>
