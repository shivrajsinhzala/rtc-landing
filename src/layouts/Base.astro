---
import { SITE } from '../config/states.mjs';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  path: string;
  jsonLd?: unknown[];
  htmlLang?: string;
  breadcrumbs?: { label: string; href: string }[];
}

const {
  title,
  description,
  keywords = 'roadways bus enquiry number, bus stand contact number, roadways bus time table, bus ticket price, यूपी रोडवेज बस टाइम टेबल, रोडवेज बस समय सारणी, बस स्टैंड पूछताछ नंबर, एसटी बस चौकशी क्रमांक, rtc enquiry number',
  path,
  jsonLd = [],
  htmlLang = 'en-IN',
  breadcrumbs = []
} = Astro.props;
const AD_CLIENT = 'ca-pub-7164999486301748';
const canonical = `${SITE}${path}`;

const baseJsonLd: unknown[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RTC Portal',
    url: `${SITE}/`,
    description: 'National State Road Transport Corporation Bus Station Helplines & Enquiry Directory.',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE}/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'RTC Portal',
    url: `${SITE}/`,
    logo: `${SITE}/icons/logo.svg`,
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: '1800-180-2877',
        contactType: 'UPSRTC Passenger Helpline',
        areaServed: 'IN-UP',
        availableLanguage: ['Hindi', 'English'],
      },
      {
        '@type': 'ContactPoint',
        telephone: '1800-22-1250',
        contactType: 'MSRTC Passenger Helpline',
        areaServed: 'IN-MH',
        availableLanguage: ['Marathi', 'Hindi', 'English'],
      },
      {
        '@type': 'ContactPoint',
        telephone: '1800-2000-103',
        contactType: 'RSRTC Passenger Helpline',
        areaServed: 'IN-RJ',
        availableLanguage: ['Hindi', 'English'],
      },
      {
        '@type': 'ContactPoint',
        telephone: '1800-180-2057',
        contactType: 'Haryana Roadways Passenger Helpline',
        areaServed: 'IN-HR',
        availableLanguage: ['Hindi', 'English'],
      },
      {
        '@type': 'ContactPoint',
        telephone: '112',
        contactType: 'National Emergency Service',
        areaServed: 'IN',
      },
    ],
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang={htmlLang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="google-adsense-account" content={AD_CLIENT} />

<!-- Google Fonts: Space Grotesk (Display), DM Sans (Body), DM Mono (Metadata) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

<!-- AdSense Script -->
<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${AD_CLIENT}`} crossorigin="anonymous"></script>

<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1" />

<!-- OpenGraph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="RTC Portal" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={`${SITE}/icons/logo.svg`} />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Theme Colors & Favicons -->
<meta name="theme-color" content="#152339" />
<link rel="icon" href="/icons/logo.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<!-- JSON-LD Structured Data -->
{baseJsonLd.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
</head>
<body>

<!-- Accessible Skip Link -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- 1. Top Utility Line -->
<div class="top-utility-bar">
  <div class="wrap top-utility-inner">
    <div class="utility-badge-text">
      <svg width="14" height="10" viewBox="0 0 24 16" fill="none" aria-hidden="true">
        <rect width="24" height="5.33" fill="#FF9933"/>
        <rect y="5.33" width="24" height="5.34" fill="#FFFFFF"/>
        <rect y="10.67" width="24" height="5.33" fill="#138808"/>
        <circle cx="12" cy="8" r="2.2" stroke="#000080" stroke-width="0.7"/>
      </svg>
      <span>National State Road Transport Helpline Directory · Public Utility</span>
    </div>
    <div class="utility-emergency-links">
      <a class="utility-tel-link" href="tel:112">Emergency: 112</a>
      <a class="utility-tel-link" href="tel:1033">Highway Helpline: 1033</a>
    </div>
  </div>
</div>

<!-- 2. Header / Navigation -->
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand-wrap" href="/" aria-label="RTC Portal Home">
      <img class="brand-logo" src="/icons/logo.svg" alt="RTC Portal Logo" width="36" height="36" />
      <div class="brand-titles">
        <span class="brand-title">RTC Portal</span>
        <span class="brand-tagline">Indian State Road Transport Directory</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="header-nav" aria-label="Main Navigation">
      <a class="nav-link" href="/states">State RTCs</a>
      <a class="nav-link" href="/timetables">Timetables</a>
      <a class="nav-link" href="/emergency">Emergency</a>
      <a class="btn-primary-action" href="/#national-search-input" id="header-search-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span>Find information</span>
      </a>
    </nav>

    <!-- Mobile Hamburger Button -->
    <button class="mobile-menu-toggle" id="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12" class="line-mid"/>
        <line x1="3" y1="6" x2="21" y2="6" class="line-top"/>
        <line x1="3" y1="18" x2="21" y2="18" class="line-bot"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Nav Drawer -->
  <div class="mobile-nav-drawer" id="mobile-nav-drawer" role="region" aria-label="Mobile Navigation">
    <a class="mobile-nav-link" href="/states">State RTCs Directory</a>
    <a class="mobile-nav-link" href="/timetables">Intercity Timetables</a>
    <a class="mobile-nav-link" href="/emergency">Emergency &amp; Highway Desks</a>
    <a class="mobile-nav-link" href="/#national-search-input" style="color:var(--primary-blue);font-weight:700;">Search Stations &amp; Corridors</a>
  </div>
</header>

<!-- Breadcrumbs Navigation -->
{breadcrumbs.length > 0 && (
  <nav class="wrap breadcrumbs-nav" aria-label="Breadcrumb">
    <ol class="breadcrumbs-list">
      <li><a href="/">Home</a></li>
      {breadcrumbs.map((crumb, idx) => (
        <>
          <li class="breadcrumbs-sep" aria-hidden="true">›</li>
          <li>
            {idx === breadcrumbs.length - 1 ? (
              <span class="breadcrumbs-current" aria-current="page">{crumb.label}</span>
            ) : (
              <a href={crumb.href}>{crumb.label}</a>
            )}
          </li>
        </>
      ))}
    </ol>
  </nav>
)}

<!-- Main Content Landmark -->
<main id="main-content" class="main-content">
  <slot />
</main>

<!-- Institutional Footer -->
<footer class="site-footer">
  <div class="wrap footer-top">
    <div>
      <div class="footer-brand-title">
        <img src="/icons/logo.svg" alt="" width="24" height="24" aria-hidden="true" />
        <span>RTC Portal</span>
      </div>
      <p class="footer-brand-desc">
        RTC Portal is an independent national directory compiled from published transport records. It helps commuters quickly find bus stand inquiry desks, station master telephone lines, and intercity bus timetable references across India.
      </p>
    </div>

    <div>
      <h3 class="footer-heading">Emergency &amp; Highway</h3>
      <ul class="footer-links">
        <li><a href="tel:112">National Emergency: 112</a></li>
        <li><a href="tel:1033">National Highway: 1033</a></li>
        <li><a href="tel:1090">Women Powerline: 1090</a></li>
        <li><a href="tel:1073">Road Accident Helpline: 1073</a></li>
        <li><a href="/emergency">Full Emergency Directory</a></li>
      </ul>
    </div>

    <div>
      <h3 class="footer-heading">State Transport Hubs</h3>
      <ul class="footer-links">
        <li><a href="/uttar-pradesh">Uttar Pradesh (UPSRTC)</a></li>
        <li><a href="/maharashtra">Maharashtra (MSRTC)</a></li>
        <li><a href="/rajasthan">Rajasthan (RSRTC)</a></li>
        <li><a href="/haryana">Haryana Roadways</a></li>
        <li><a href="/himachal-pradesh">Himachal Pradesh (HRTC)</a></li>
        <li><a href="/uttarakhand">Uttarakhand (UTC)</a></li>
        <li><a href="/punjab">Punjab (PUNBUS / PRTC)</a></li>
        <li><a href="/states" style="color:var(--muted-blue);font-weight:600;">View All 8 State RTCs</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>
      © 2026 RTC Portal. Independent public directory compiled from published transport records. Not affiliated with or endorsed by any government transport department. Verify critical details with respective RTCs before travel.
    </p>
    <div style="display:flex;gap:1.25rem;">
      <a href="/timetables">Timetables</a>
      <a href="/states">State RTCs</a>
      <a href="/emergency">Emergency</a>
      <a href="/sitemap-index.xml">Sitemap</a>
    </div>
  </div>
</footer>

<script>
  // Mobile Nav Toggle Script
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (menuBtn && drawer) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      drawer.classList.toggle('open');
    });

    // Close on navigation click
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menuBtn.setAttribute('aria-expanded', 'false');
        drawer.classList.remove('open');
      });
    });
  }

  // Header "Find information" button focuses search input
  const headerSearchBtn = document.getElementById('header-search-btn');
  if (headerSearchBtn) {
    headerSearchBtn.addEventListener('click', (e) => {
      const searchInput = document.getElementById('national-search-input');
      if (searchInput) {
        e.preventDefault();
        searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        searchInput.focus();
      }
    });
  }

  // Resilient multi-slot AdSense binding
  function initAds() {
    const slots = document.querySelectorAll('ins.adsbygoogle');
    slots.forEach((slot) => {
      if (slot.dataset.bound === '1') return;
      slot.dataset.bound = '1';
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch {}
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAds);
  } else {
    initAds();
  }
</script>

</body>
</html>
