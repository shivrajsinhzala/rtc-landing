---
import Base from './Base.astro';
import AdSlot from './../components/AdSlot.astro';
import { ROUTES } from '../data/routes.data.mjs';

interface Stand { label: string; numbers: string[]; }
interface Props {
  state: { name: string; corporation: string; slug: string; helpline: { primary: string; label: string }; officialSite?: string };
  depot: { city: string; region: string; alsoKnownAs?: string; stands: Stand[] };
  cityName: string;
  path: string;
  siblingLinks: { href: string; label: string }[];
  hubHref: string;
}

const { state, depot, cityName, path, siblingLinks, hubHref } = Astro.props;
const { stands } = depot;
const multi = stands.length > 1;
const tel = (n: string) => n.replace(/[^0-9]/g, '');
const alias = depot.alsoKnownAs ? ` (${depot.region} division HQ, also known as ${depot.alsoKnownAs})` : '';

const primaryStand = stands[0];
const primaryNumber = primaryStand.numbers[0];

const title = `${cityName} Bus Stand Contact Number & Enquiry — ${state.corporation}`;
const description = `Published directory reference for ${state.corporation} ${cityName} bus stand enquiry telephone numbers: ${primaryNumber}. Sourced contact numbers for ${stands.length} depot counters, station master desks, bus schedules, and 24x7 helpline.`;

// Connected express routes originating or ending at this depot
const connectedRoutes = ROUTES.filter(
  (r) =>
    r.originCity.toLowerCase() === depot.city.toLowerCase() ||
    r.destinationCity.toLowerCase() === depot.city.toLowerCase() ||
    r.originCity.toLowerCase() === cityName.toLowerCase() ||
    r.destinationCity.toLowerCase() === cityName.toLowerCase()
);

const breadcrumbs = [
  { label: 'State RTCs', href: '/states' },
  { label: state.name, href: hubHref },
  { label: `${cityName} Bus Station`, href: path },
];

const faqs = [
  {
    q: `What is the published ${state.corporation} enquiry number for ${cityName} bus station?`,
    a: `The primary inquiry phone number for ${cityName} bus station is ${primaryNumber}. For 24x7 statewide customer service, commuters can also dial the toll-free helpline at ${state.helpline.primary}.`
  },
  {
    q: `How many bus stands operate under the ${cityName} (${depot.region}) division?`,
    a: `The ${cityName} division operates ${stands.length} major bus station${multi ? 's' : ''}: ${stands.map(s => s.label).join(', ')}. Each terminal has designated enquiry counters and station master desks.`
  },
  {
    q: `What should I do if the ${cityName} bus stand phone line is busy or not answering?`,
    a: `Depot enquiry lines may be busy during peak morning and evening departure hours. If the local desk does not connect, call the 24x7 central ${state.corporation} passenger helpline at ${state.helpline.primary} or dial the national emergency helpline at 112.`
  },
  {
    q: `Can I book ${state.corporation} bus tickets online from ${cityName}?`,
    a: `Yes, seat reservations for ${state.corporation} bus services departing ${cityName} can be booked online through the official portal (${state.officialSite || 'online portal'}).`
  }
];

const regionalTerms = state.corporation === 'MSRTC'
  ? `${cityName} एसटी बस चौकशी क्रमांक, ${cityName} बस स्थानक संपर्क, एसटी वेळापत्रक`
  : `${cityName} बस स्टैंड इंक्वायरी नंबर, ${cityName} रोडवेज फोन नंबर, ${cityName} रोडवेज बस टाइम टेबल, समय सारणी`;

const keywords = `${cityName} bus stand contact number, ${cityName} bus stand enquiry number, ${cityName} roadways phone number, ${state.corporation} ${cityName} enquiry, ${cityName} bus time table, ${cityName} bus stand ticket counter, ${regionalTerms}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    keywords,
    url: `https://rtc.shivrajsinh.in${path}`,
    about: {
      '@type': 'BusStation',
      name: `${cityName} ${state.corporation} Bus Station`,
      alternateName: state.corporation === 'MSRTC' ? `${cityName} एसटी बस स्थानक` : `${cityName} रोडवेज बस स्टैंड`,
      telephone: primaryNumber,
      address: {
        '@type': 'PostalAddress',
        addressLocality: cityName,
        addressRegion: state.name,
        addressCountry: 'IN',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rtc.shivrajsinh.in/' },
      { '@type': 'ListItem', position: 2, name: 'State RTCs', item: 'https://rtc.shivrajsinh.in/states' },
      { '@type': 'ListItem', position: 3, name: state.name, item: `https://rtc.shivrajsinh.in${hubHref}` },
      { '@type': 'ListItem', position: 4, name: `${cityName} Bus Station`, item: `https://rtc.shivrajsinh.in${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];
---

<Base title={title} description={description} keywords={keywords} path={path} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  
  <div class="wrap" style="padding-top:1rem;padding-bottom:3rem;">

    <!-- Page Header -->
    <section style="margin-bottom:2rem;">
      <div style="font-family:var(--font-mono);font-size:0.75rem;font-weight:700;color:var(--primary-blue);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.35rem;">
        {state.corporation} Divisional Directory · {state.name}
      </div>
      <h1 class="section-title" style="font-size:2.2rem;margin-bottom:0.4rem;">
        {cityName} Bus Station Contact Number &amp; Enquiry
      </h1>
      <p style="font-size:0.95rem;font-weight:600;color:var(--primary-blue);margin-bottom:0.75rem;">
        {state.corporation === 'MSRTC' ? `${cityName} एसटी बस स्थानक संपर्क क्रमांक व चौकशी कक्ष` : `${cityName} रोडवेज बस स्टैंड पूछताछ नंबर एवं समय सारणी`}
      </p>
      <p class="section-subtitle" style="font-size:1.05rem;line-height:1.6;max-width:760px;">
        Published directory reference for <strong>{cityName}</strong>{alias} under <strong>{state.corporation}</strong>. Direct telephone connections to station master counters, platform inquiry desks, and the 24×7 statewide helpline.
      </p>
    </section>

    <!-- Instant Dial Action Strip -->
    <section class="dial-action-strip" aria-label="Direct Phone Dial">
      <div class="dial-strip-header">
        <div class="dial-strip-title">{cityName} Station Master &amp; Inquiry Counters</div>
        <div class="dial-strip-sub">Direct telephone connection to platform enquiry desks</div>
      </div>

      <div class="call-button-group">
        {stands.flatMap((s) => s.numbers).slice(0, 4).map((n) => (
          <a class="btn-dial" href={`tel:${tel(n)}`}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Call {n}</span>
          </a>
        ))}
        <a class="btn-dial secondary" href={`tel:${tel(state.helpline.primary)}`}>
          <span>Toll-Free: {state.helpline.primary}</span>
        </a>
        <a class="btn-dial secondary" href={hubHref}>
          <span>All {state.name} Depots</span>
        </a>
      </div>
    </section>

    <!-- Above-The-Fold Ad Slot -->
    <AdSlot slotId="8460038937" label="Advertisement" />

    <!-- Complete Bus Stand Table (Desktop) / Cards (Mobile) -->
    <section aria-labelledby="depot-table-heading" style="margin:2.5rem 0;">
      <h2 class="section-title" id="depot-table-heading" style="font-size:1.55rem;margin-bottom:0.35rem;">
        {cityName} Bus Stations &amp; Enquiry Counters
      </h2>
      <p class="section-subtitle" style="margin-bottom:1rem;">
        Designated passenger platform counters and station master desks in this division:
      </p>

      <div class="table-container">
        <table class="depot-table">
          <thead>
            <tr>
              <th scope="col">Terminal / Station Name</th>
              <th scope="col">Enquiry Phone Number(s)</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          <tbody>
            {stands.map((s) => (
              <tr>
                <td class="depot-name-cell">{s.label}</td>
                <td class="depot-number-cell">
                  <div style="display:flex;flex-wrap:wrap;gap:0.75rem;">
                    {s.numbers.map((n) => (
                      <a class="utility-tel-link" href={`tel:${tel(n)}`} style="color:var(--primary-blue);font-weight:600;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        <span>{n}</span>
                      </a>
                    ))}
                  </div>
                </td>
                <td>
                  <a class="btn-dial secondary" href={`tel:${tel(s.numbers[0])}`} style="padding:0.35rem 0.75rem;font-size:0.78rem;">
                    Call Desk
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Mid-Content Ad Slot -->
    <AdSlot slotId="8460038937" label="Advertisement" />

    <!-- Connected Intercity Bus Routes & Timetables -->
    {connectedRoutes.length > 0 && (
      <section aria-labelledby="connected-routes-heading" style="margin:2.5rem 0;">
        <h2 class="section-title" id="connected-routes-heading" style="font-size:1.45rem;margin-bottom:0.35rem;">
          Bus Timetables &amp; Routes from {cityName}
        </h2>
        <p class="section-subtitle" style="margin-bottom:1rem;">
          Departure schedules, ticket fares, distance, and highway routes connecting {cityName}:
        </p>
        <div class="routes-grid">
          {connectedRoutes.map((r) => (
            <a class="route-card" href={`/${state.slug}/routes/${r.slug}`}>
              <div>
                <div class="route-card-header">
                  <span class="route-card-operator">{r.corporation} Express</span>
                  <span class="route-card-duration">{r.durationHours}</span>
                </div>
                <h3 class="route-card-corridor" style="font-size:1.15rem;">{r.originCity} ⇄ {r.destinationCity}</h3>
                <p class="route-card-specs">
                  {r.distanceKm} km · {r.frequency}
                  <br />
                  First departure: {r.firstBus} · Night: {r.lastBus}
                </p>
              </div>
              <div class="route-card-footer">
                <span class="route-card-fare">From {r.fares[0].price}</span>
                <span class="route-card-action">View timetable</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Frequently Asked Questions (FAQ Section) -->
    <section class="faq-section" aria-labelledby="faq-heading">
      <h2 class="section-title" id="faq-heading" style="font-size:1.45rem;margin-bottom:0.75rem;">
        Frequently Asked Questions ({cityName} Bus Enquiry)
      </h2>
      <div class="faq-group">
        {faqs.map(f => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <div class="faq-answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Trust & Counter Verification Notice Box -->
    <section class="trust-statement-box" aria-label="Station Master Notice">
      <h3 class="trust-statement-title">Station Master Counter Notice</h3>
      <p class="trust-statement-text">
        Telephone numbers listed above are compiled from published records of {state.corporation} for the {depot.region} division. In case local platform enquiry desks are engaged during peak departure rush, dial the 24×7 toll-free passenger customer service line at <strong>{state.helpline.primary}</strong> or National Emergency at <strong>112</strong>.
      </p>
    </section>

    <!-- Pre-Footer Ad Slot -->
    <AdSlot slotId="8460038937" label="Sponsored" />

    <!-- Sibling Regional Depots Mesh (Zero Orphan Links) -->
    {siblingLinks.length > 0 && (
      <section class="sibling-mesh" aria-labelledby="nearby-depots-heading">
        <h3 class="section-title" id="nearby-depots-heading" style="font-size:1.15rem;margin-bottom:0.35rem;">
          Other Regional Bus Stands in {state.name}
        </h3>
        <p class="section-subtitle" style="font-size:0.85rem;">Direct inquiry numbers for connected transport divisions:</p>
        <ul class="sibling-grid">
          {siblingLinks.map((link) => (
            <li>
              <a class="sibling-link" href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </div>

</Base>
