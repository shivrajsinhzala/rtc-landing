---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { ROUTES } from '../data/routes.data.mjs';

interface Stand { label: string; numbers: string[]; }
interface Props {
  state: { name: string; corporation: string; slug: string; helpline: { primary: string; label: string }; officialSite?: string };
  depot: { city: string; region: string; alsoKnownAs?: string; stands: Stand[] };
  cityName: string;
  path: string;
  siblingLinks: { href: string; label: string }[];
  hubHref: string;
}

const { state, depot, cityName, path, siblingLinks, hubHref } = Astro.props;
const { stands } = depot;
const multi = stands.length > 1;
const tel = (n: string) => n.replace(/[^0-9]/g, '');
const alias = depot.alsoKnownAs ? ` (division HQ, also known as ${depot.alsoKnownAs})` : '';

const primaryStand = stands[0];
const primaryNumber = primaryStand.numbers[0];

const title = `${cityName} Bus Stand Contact Number, Time Table & Enquiry — ${state.corporation}`;
const description = `Verified 2026 ${state.corporation} ${cityName} bus stand enquiry number: ${primaryNumber}. Official phone numbers for ${stands.length} depot counters, station master desk, bus timings, fares & 24x7 helpline.`;

// Connected express routes originating or ending at this depot
const connectedRoutes = ROUTES.filter(
  (r) =>
    r.originCity.toLowerCase() === depot.city.toLowerCase() ||
    r.destinationCity.toLowerCase() === depot.city.toLowerCase() ||
    r.originCity.toLowerCase() === cityName.toLowerCase() ||
    r.destinationCity.toLowerCase() === cityName.toLowerCase()
);

const breadcrumbs = [
  { label: state.name, href: hubHref },
  { label: `${cityName} Bus Station`, href: path },
];

// Rich FAQ generation for Google Rich Snippets & AI Citations
const faqs = [
  {
    q: `What is the official ${state.corporation} enquiry number for ${cityName} bus station?`,
    a: `The primary ${state.corporation} inquiry phone number for ${cityName} is ${primaryNumber}. For 24x7 statewide customer service, commuters can also dial the toll-free helpline at ${state.helpline.primary}.`
  },
  {
    q: `How many bus stands operate under the ${cityName} (${depot.region}) division?`,
    a: `The ${cityName} region operates ${stands.length} major bus station${multi ? 's' : ''}: ${stands.map(s => s.label).join(', ')}. Each terminal has designated enquiry counters and station master desks.`
  },
  {
    q: `What should I do if the ${cityName} bus stand phone line is busy or not answering?`,
    a: `Depot enquiry lines may be engaged during peak departure hours. If the local line does not connect, call the 24x7 central ${state.corporation} passenger helpline at ${state.helpline.primary} or dial the national emergency helpline at 112.`
  },
  {
    q: `Can I book ${state.corporation} bus tickets online from ${cityName}?`,
    a: `Yes, advance seat reservation for ${state.corporation} bus services departing ${cityName} can be booked online through the official ${state.corporation} portal (${state.officialSite || 'online portal'}).`
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: `https://rtc.shivrajsinh.in${path}`,
    about: {
      '@type': 'BusStation',
      name: `${cityName} ${state.corporation} Bus Station`,
      telephone: primaryNumber,
      address: {
        '@type': 'PostalAddress',
        addressLocality: cityName,
        addressRegion: state.name,
        addressCountry: 'IN',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://rtc.shivrajsinh.in/' },
      { '@type': 'ListItem', position: 2, name: state.name, item: `https://rtc.shivrajsinh.in${hubHref}` },
      { '@type': 'ListItem', position: 3, name: `${cityName} Bus Station`, item: `https://rtc.shivrajsinh.in${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];
---

<Base title={title} description={description} path={path} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  
  <section class="page-hero">
    <div class="badge-official">Official Government Sourced · Verified 2026</div>
    <h1 class="page-title">{cityName} Bus Station Contact Number &amp; Enquiry</h1>
    <p class="page-lede">
      Official {state.corporation} ({state.corporation}) Roadways enquiry phone numbers for <strong>{cityName}</strong>{alias}. Direct telephone access to station master counters, platform inquiry desks, and the 24x7 statewide passenger helpline.
    </p>
  </section>

  <!-- 1-Tap Quick Call Card -->
  <section class="action-card" aria-label="Quick Call Actions">
    <div class="action-card-header">
      <span class="action-card-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>Instant Phone Dial (Tap to Call)</span>
      </span>
      <span class="action-card-subtitle">{cityName} Depot Enquiry Counters</span>
    </div>

    <div class="call-button-group">
      {stands.flatMap((s) => s.numbers).slice(0, 4).map((n) => (
        <a class="btn-call" href={`tel:${tel(n)}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Call {n}</span>
        </a>
      ))}
      <a class="btn-call secondary" href={`tel:${tel(state.helpline.primary)}`}>
        <span>Toll-Free Helpline: {state.helpline.primary}</span>
      </a>
    </div>
  </section>

  <!-- Above-The-Fold Ad Slot -->
  <AdSlot slotId="8460038937" label="Sponsored Advertisement" />

  <!-- Complete Bus Stand Table -->
  <section aria-labelledby="depot-table-heading">
    <h2 class="section-h2" id="depot-table-heading">{cityName} Bus Stations &amp; Enquiry Counters</h2>
    <div class="table-container">
      <table class="depot-table">
        <thead>
          <tr>
            <th scope="col">Terminal / Station Name</th>
            <th scope="col">Enquiry Phone Number(s)</th>
            <th scope="col">Counter Action</th>
          </tr>
        </thead>
        <tbody>
          {stands.map((s) => (
            <tr>
              <td class="depot-name-cell">{s.label}</td>
              <td class="depot-number-cell">
                {s.numbers.map((n) => (
                  <a class="depot-phone-link" href={`tel:${tel(n)}`}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <span>{n}</span>
                  </a>
                ))}
              </td>
              <td>
                <a class="nav-pill-btn" href={`tel:${tel(s.numbers[0])}`}>Call Desk</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Mid-Content Ad Slot -->
  <AdSlot slotId="8460038937" label="Advertisement" />

  <!-- Statewide Backup Support -->
  <section class="action-card" style="border-left-color: var(--emerald);" aria-label="Support Information">
    <div class="action-card-header">
      <span class="action-card-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>If Local Depot Lines Are Busy</span>
      </span>
      <span class="action-card-subtitle">24x7 Central Passenger Support</span>
    </div>
    <p style="color:var(--ink-muted);font-size:0.9rem;line-height:1.6;">
      {state.helpline.label} provides round-the-clock telephone support for bus schedule confirmations, fare inquiries, and passenger grievances across {state.name}:
      <a style="color:var(--cobalt);font-weight:700;text-decoration:none;" href={`tel:${tel(state.helpline.primary)}`}>
        {state.helpline.primary}
      </a>.
    </p>
  </section>

  <!-- Frequently Asked Questions (FAQ Section) -->
  <section class="faq-section" aria-labelledby="faq-heading">
    <h2 class="section-h2" id="faq-heading">Frequently Asked Questions ({cityName} Bus Enquiry)</h2>
    <div class="faq-group">
      {faqs.map(f => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <div class="faq-answer">
            <p>{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- Pre-Footer Ad Slot -->
  <AdSlot slotId="8460038937" label="Sponsored" />

  <!-- Connected Intercity Bus Routes & Timetables -->
  {connectedRoutes.length > 0 && (
    <section class="sibling-mesh" aria-labelledby="connected-routes-heading" style="margin-top:2rem;">
      <h2 class="section-h2" id="connected-routes-heading" style="font-size:1.1rem;margin-bottom:0.4rem;">
        Popular Bus Timetables &amp; Routes from {cityName}
      </h2>
      <p style="color:var(--ink-light);font-size:0.85rem;">Check bus timings, ticket fares, distance, and platform numbers for departures from {cityName}:</p>
      <ul class="sibling-grid" style="grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));">
        {connectedRoutes.map((r) => (
          <li>
            <a class="sibling-link" href={`/${state.slug}/routes/${r.slug}`} style="display:flex;flex-direction:column;gap:0.3rem;">
              <span style="font-weight:700;color:var(--ink);">{r.originCity} to {r.destinationCity} Bus Schedule →</span>
              <span style="font-size:0.78rem;color:var(--ink-light);">{r.frequency} · Fares from {r.fares[0].price} · {r.durationHours}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Sibling Regional Depots Mesh -->
  {siblingLinks.length > 0 && (
    <section class="sibling-mesh" aria-labelledby="nearby-depots-heading">
      <h2 class="section-h2" id="nearby-depots-heading" style="font-size:1.1rem;margin-bottom:0.4rem;">
        Other Regional Bus Stands in {state.name}
      </h2>
      <p style="color:var(--ink-light);font-size:0.85rem;">Direct inquiry numbers for neighbouring transport divisions:</p>
      <ul class="sibling-grid">
        {siblingLinks.map((link) => (
          <li>
            <a class="sibling-link" href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

</Base>
